{
  "name": "console-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 5173",
    "build": "node tools/production-runtime.mjs --build",
    "start": "node server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:production-routes": "node tools/test-production-routes.mjs",
    "test:source-closure": "python3 -m unittest discover -s tools -p 'test_*.py'",
    "test:acceptance": "python3 tools/acceptance.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.475.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}

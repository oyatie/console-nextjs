  "requirement": {
    "source": "PLAN.md",
    "id": "B06",
    "owner": "console_inbox_adapter_postgres::PgInboxStore::list",
    "contract": "InboxDocPage.next_cursor is None at the end; chronological owned anchors remain valid across filters. List metadata never carries payload."
  },
  "behavior": "Fetch at most clamped1..200 plus one eligible row within the unchanged recipient/RLS/filter query. Return only requested page; next cursor is last returned ID only when actual eligible lookahead exists.",
  "test_names": [
    "concurrent_dedup_collision_revalidates_the_committed_document",
    "dedup_redelivery_requires_every_immutable_field_and_preserves_the_receipt",
    "filters_and_dedup_idempotency",
    "foreign_cursors_fail_closed_and_owned_chronological_anchors_survive_filter_changes",
    "full_terminal_page_ignores_other_recipients_companies_and_kinds",
    "legal_notice_lock_confirm_and_cross_user_isolation",
    "maximum_page_size_is_bounded_and_exact_full_tail_terminates",
    "payslip_is_frictionless_and_never_receipt_confirmed",
    "tied_timestamps_page_without_gaps_duplicates_or_phantom_next"
  ],

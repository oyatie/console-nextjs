{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console.local/schemas/lane-receipt.schema.json",
  "title": "Tracked lane receipt",
  "oneOf": [
    { "$ref": "#/$defs/laneReceipt" },
    { "$ref": "#/$defs/criticReceipt" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "laneReceipt": {
      "type": "object",
      "required": [
        "kind",
        "lane",
        "status",
        "summary",
        "filesChanged",
        "redBaseline",
        "verification",
        "contractBreaches",
        "headSha",
        "baseSha",
        "worktree",
        "commandsRun",
        "enforcementPlacement",
        "peripheralsUpdated",
        "classification",
        "preMortem",
        "blastRadius",
        "detection",
        "rollback",
        "stopConditions",
        "reviewIdentities",
        "remainingHolds",
        "result",
        "followUps"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["lane"] },
        "lane": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "type": "string", "enum": ["done", "partial", "blocked"] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "filesChanged": { "$ref": "#/$defs/nonEmptyStringArray" },
        "redBaseline": { "$ref": "#/$defs/nonEmptyString" },
        "verification": { "$ref": "#/$defs/nonEmptyString" },
        "contractBreaches": { "$ref": "#/$defs/nonEmptyString" },
        "headSha": { "$ref": "#/$defs/sha1" },
        "baseSha": { "$ref": "#/$defs/sha1" },
        "worktree": { "$ref": "#/$defs/nonEmptyString" },
        "commands": { "$ref": "#/$defs/nonEmptyStringArray" },
        "commandsRun": { "$ref": "#/$defs/nonEmptyStringArray" },
        "enforcementPlacement": { "$ref": "#/$defs/nonEmptyString" },
        "peripheralsUpdated": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "$ref": "#/$defs/nonEmptyStringArray" }
          ]
        },
        "classification": {
          "type": "object",
          "required": ["personalData", "holdAdjacent", "notes"],
          "properties": {
            "personalData": { "type": "boolean" },
            "holdAdjacent": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "preMortem": { "$ref": "#/$defs/nonEmptyString" },
        "blastRadius": { "$ref": "#/$defs/nonEmptyString" },
        "detection": { "$ref": "#/$defs/nonEmptyString" },
        "rollback": { "$ref": "#/$defs/nonEmptyString" },
        "stopConditions": { "$ref": "#/$defs/nonEmptyString" },
        "reviewIdentities": { "$ref": "#/$defs/nonEmptyStringArray" },
        "remainingHolds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "result": { "type": "string", "enum": ["green", "red", "parked"] },
        "followUps": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "criticReceipt": {
      "type": "object",
      "required": ["kind", "verdict", "findings"],
      "properties": {
        "kind": { "type": "string", "enum": ["critic"] },
        "verdict": { "type": "string", "enum": ["APPROVE", "BLOCK"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "claim",
        "failureScenario",
        "location",
        "provenByExecution",
        "ownerLease"
      ],
      "properties": {
        "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "failureScenario": { "$ref": "#/$defs/nonEmptyString" },
        "location": { "$ref": "#/$defs/nonEmptyString" },
        "provenByExecution": { "type": "boolean" },
        "ownerLease": { "type": "boolean" }
      }
    }
  }
}
